#!/bin/bash

# script/lint-check: Check linting without making changes
#
# Runs Ruff in check-only mode without applying fixes. Useful for CI/CD
# and pre-commit validation.
#
# Usage:
#   ./script/lint-check
#
# Examples:
#   ./script/lint-check

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"

activate_venv

run_hook "lint-check" "pre"

"$SCRIPT_DIR/python-check"
echo ""
"$SCRIPT_DIR/yaml-check"
echo ""
"$SCRIPT_DIR/shell-check"
echo ""
"$SCRIPT_DIR/markdown-check"

run_hook "lint-check" "post"
log_success "Linting check completed"
