#!/bin/bash

# script/shell: Format shell scripts with shfmt

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"

run_hook "shell" "pre"

log_header "Running shfmt"
find script/ .devcontainer/ -not -path "script/hooks/*" -not -path ".devcontainer/hooks/*" -type f \( -name "*.sh" -o ! -name "*.*" \) -print0 | xargs -0 shfmt -i 4 -w

run_hook "shell" "post"
log_success "Shell formatting completed"
